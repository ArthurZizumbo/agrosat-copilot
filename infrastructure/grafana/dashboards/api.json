{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource Prometheus que scrapea /metrics de la API AgroSatCopilot.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "AgroSatCopilot - API",
  "uid": "agrosat-api",
  "tags": ["agrosatcopilot", "api", "us-059"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Latencia HTTP p50 / p95 / p99 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Percentiles derivados de http_request_duration_seconds via histogram_quantile. El umbral de alerta de p99 es 3 s (ver alerts/alert_rules.yml).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "RPS por endpoint (route template)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "rate(http_requests_total) agrupado por plantilla de ruta. El label path es el template (p.ej. /aois/{aoi_id}) para evitar explosion de cardinalidad por id.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{method}} {{path}}",
          "expr": "sum by (method, path) (rate(http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate 5xx (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Fraccion de respuestas 5xx sobre el total. Umbral de alerta: > 5% (ver alerts/alert_rules.yml).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "error rate 5xx",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Excepciones no manejadas (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "rate(http_request_exceptions_total): excepciones propagadas antes de que un handler produzca respuesta.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{method}} {{path}}",
          "expr": "sum by (method, path) (rate(http_request_exceptions_total[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latencia chat p95 (slot US-065)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "PLANTILLA - se puebla en US-065 con trafico /chat real. Mientras tanto reusa el histograma HTTP filtrado a la ruta /chat. La metrica chat dedicada (tokens, modelo activo, tool-call success rate) la promueve US-065 desde los logs structlog del ChatService.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "chat p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{path=\"/chat\"}[5m])))"
        }
      ]
    }
  ]
}
