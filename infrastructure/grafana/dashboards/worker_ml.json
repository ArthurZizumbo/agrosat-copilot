{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource Prometheus que scrapea el worker ML (dcgm-exporter en la GPU + metricas de inferencia).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "AgroSatCopilot - Worker ML (GPU)",
  "uid": "agrosat-worker-ml",
  "tags": ["agrosatcopilot", "worker-ml", "gpu", "us-059"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "GPU utilization (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "PLANTILLA - requiere dcgm-exporter scrapeando la H100 NVL (sponsor) o la L4 spot. Metrica: DCGM_FI_DEV_GPU_UTIL. Sin scrape activo en este entorno (ver docs/blockers/epic10-notas.md).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{gpu}} {{Hostname}}",
          "expr": "DCGM_FI_DEV_GPU_UTIL"
        }
      ]
    },
    {
      "id": 2,
      "title": "GPU memoria usada (MiB)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "PLANTILLA - DCGM_FI_DEV_FB_USED. Sirve para detectar OOM inminente; la alerta GpuOutOfMemory dispara cuando la fraccion usada/total supera el umbral (ver alerts/alert_rules.yml).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "used {{gpu}}",
          "expr": "DCGM_FI_DEV_FB_USED"
        },
        {
          "refId": "B",
          "legendFormat": "free {{gpu}}",
          "expr": "DCGM_FI_DEV_FB_FREE"
        }
      ]
    },
    {
      "id": 3,
      "title": "GPU memoria usada (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "PLANTILLA - fraccion de VRAM usada = FB_USED / (FB_USED + FB_FREE). Umbral de alerta OOM: > 95%.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "vram usada {{gpu}}",
          "expr": "DCGM_FI_DEV_FB_USED / clamp_min(DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE, 1)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latencia de inferencia del worker (slot)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "PLANTILLA - se puebla cuando el worker de inferencia (Pub/Sub, EPIC 8) y/o el serving Qwen (US-048) exporten metricas propias. Metrica esperada: inference_request_duration_seconds (histograma).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "inference p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inference_request_duration_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
